## Environment settings
## This file is generated by the "env.sh" script!

## Docker Compose file configuration
COMPOSE_DIR=.
COMPOSE_PROJECT_NAME=basic
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml:docker-compose.mariadb.yml:docker-compose.memcache.yml:docker-compose.adminer.yml

## Host specific settings
HOST_UID=33
HOST_GID=33

## Application ports
APP_PORT=8090
ADMINER_PORT=8091
PHPMYADMIN_PORT=8092

## Database specific settings (Sqlite, MariaDB etc.)
DB=mariadb
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=nopassword
DB_NAME=basic
DB_USER=basic
DB_PASSWORD=nopassword
DB_DSN=mysql://basic:nopassword@mariadb:3306/basic

## PHP specific settings
OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_SESSION_SAVE_PATH=memcached:11211
PHP_SESSION_NAME=BASIC_SESSION_ID

## Environment slug and domain
APP_SLUG=basic
APP_NAME=basic
APP_DOMAIN=basic.lan
APP_DIR=~/bassix/basic

## Application specific settings and secrets
APP_VERSION=0.0.0
APP_ENV=dev
APP_SECRET=noscecret
APP_JWT_PASSPHRASE=nopassphrase
